{
  "manifest_version": 3,
  "name": "VisioVoice",
  "version": "0.1.0",
  "description": "Racconta a parole cosa c'e' su una schermata e accompagna passo per passo chi non puo' vederla.",
  "content_scripts": [{
    "matches": ["http://localhost:8080/demo/*", "http://127.0.0.1:8080/demo/*"],
    "js": ["loader.js"],
    "run_at": "document_idle"
  }],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"]
}
